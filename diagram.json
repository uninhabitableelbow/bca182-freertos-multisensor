{
  "version": 1,
  "author": "uninhabitableelbow",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 310, "left": 650, "attrs": { "mode": "smooth", "volume": "0.1" } },
    { "type": "wokwi-ky-040", "id": "encoder", "top": 210, "left": 470, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -30, "left": 400, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-resistor", "id": "scl_pullup", "top": 130, "left": 400, "rotate": 90, "attrs": { "value": "4700" } },
    { "type": "wokwi-resistor", "id": "sda_pullup", "top": 130, "left": 450, "rotate": 90, "attrs": { "value": "4700" } },
    {
      "type": "board-stm32-bluepill",
      "id": "bluepill",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": -30,
      "left": 220,
      "attrs": {
        "temperature": "25.4",
        "humidity": "61.2"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "dht_pullup",
      "top": 100,
      "left": 175,
      "rotate": 90,
      "attrs": {
        "value": "4700"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 180,
      "left": 215,
      "attrs": {
        "lux": "500"
      }
    }
  ],
  "connections": [
    ["buzzer:2", "bluepill:B8", "red", []],
    ["buzzer:1", "bluepill:GND.1", "black", []],
    ["encoder:VCC", "bluepill:3V3.1", "red", []],
    ["encoder:GND", "bluepill:GND.1", "black", []],
    ["encoder:CLK", "bluepill:A2", "green", []],
    ["encoder:DT", "bluepill:A3", "orange", []],
    ["oled:VCC", "bluepill:3V3.1", "red", []],
    ["oled:GND", "bluepill:GND.1", "black", []],
    ["oled:SCL", "bluepill:B6", "blue", []],
    ["oled:SDA", "bluepill:B7", "purple", []],
    ["scl_pullup:1", "bluepill:3V3.1", "red", []],
    ["scl_pullup:2", "oled:SCL", "blue", []],
    ["sda_pullup:1", "bluepill:3V3.1", "red", []],
    ["sda_pullup:2", "oled:SDA", "purple", []],
    [
      "bluepill:A9",
      "$serialMonitor:RX",
      "green",
      []
    ],
    [
      "bluepill:A10",
      "$serialMonitor:TX",
      "blue",
      []
    ],
    [
      "dht22:VCC",
      "bluepill:3V3.1",
      "red",
      []
    ],
    [
      "dht22:GND",
      "bluepill:GND.1",
      "black",
      []
    ],
    [
      "dht22:SDA",
      "bluepill:A1",
      "green",
      []
    ],
    [
      "dht_pullup:1",
      "bluepill:3V3.1",
      "red",
      []
    ],
    [
      "dht_pullup:2",
      "dht22:SDA",
      "green",
      []
    ],
    [
      "ldr:VCC",
      "bluepill:3V3.1",
      "red",
      []
    ],
    [
      "ldr:GND",
      "bluepill:GND.1",
      "black",
      []
    ],
    [
      "ldr:AO",
      "bluepill:A0",
      "orange",
      []
    ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "crlf"
  }
}
